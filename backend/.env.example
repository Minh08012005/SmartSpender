# =============================================
# Backend Environment Configuration Template
# =============================================
# Cách dùng:
# 1. Copy file này thành .env
# 2. Điền các giá trị thực tế vào .env
# 3. KHÔNG commit .env lên repo (thêm vào .gitignore)
# =============================================

# Server Configuration
PORT=3000
NODE_ENV=development

# =============================================
# MongoDB Configuration
# =============================================
# Local Development
MONGODB_URI=mongodb://127.0.0.1:27017/smartspender

# Cloud (MongoDB Atlas) - uncomment để dùng
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/smartspender?retryWrites=true&w=majority

# Connection Timeouts (milliseconds)
MONGO_CONNECT_TIMEOUT=10000
MONGO_SOCKET_TIMEOUT=45000

# =============================================
# Authentication (JWT)
# =============================================
# CHANGE THIS IN PRODUCTION!
# Generate secure key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secret_key_here_change_this_in_production
JWT_EXPIRE=7d

# =============================================
# Telegram Bot (Optional)
# =============================================
# Get token from BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# =============================================
# Logging (Optional)
# =============================================
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# =============================================
# API Configuration (Optional)
# =============================================
API_TIMEOUT=30000
MAX_REQUEST_SIZE=10mb

# =============================================
# CORS Configuration (Optional)
# =============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
