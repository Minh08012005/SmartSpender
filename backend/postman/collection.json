                  "  pm.expect(pm.response.json().data.transactions).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T07 | GET transactions – pagination page=2 limit=5",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?month={{testMonth}}&year={{testYear}}&page=2&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api","transactions"],
              "query": [
                { "key": "month", "value": "{{testMonth}}" },
                { "key": "year", "value": "{{testYear}}" },
                { "key": "page", "value": "2" },
                { "key": "limit", "value": "5" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-T07: Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('TC-T07: page=2 reflected', () => pm.expect(body.data.page).to.equal(2));",
                  "pm.test('TC-T07: limit=5 reflected', () => pm.expect(body.data.limit).to.equal(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T08 | GET transactions – sort by amount asc",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?month={{testMonth}}&year={{testYear}}&sortBy=amount&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api","transactions"],
              "query": [
                { "key": "month", "value": "{{testMonth}}" },
                { "key": "year", "value": "{{testYear}}" },
                { "key": "sortBy", "value": "amount" },
                { "key": "order", "value": "asc" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-T08: Status 200', () => pm.response.to.have.status(200));",
                  "const txns = pm.response.json().data.transactions;",
                  "pm.test('TC-T08: ascending order', () => {",
                  "  for (let i = 1; i < txns.length; i++) {",
                  "    pm.expect(txns[i].amount).to.be.at.least(txns[i-1].amount);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
