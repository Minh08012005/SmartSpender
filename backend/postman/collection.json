                  "pm.test('TC-T05: all results category=food', () => {",
                  "  txns.forEach(t => pm.expect(t.category).to.equal('food'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T06 | GET transactions – search keyword",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?month={{testMonth}}&year={{testYear}}&search=lunch",
              "host": ["{{baseUrl}}"],
              "path": ["api","transactions"],
              "query": [
                { "key": "month", "value": "{{testMonth}}" },
                { "key": "year", "value": "{{testYear}}" },
                { "key": "search", "value": "lunch" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-T06: Status 200', () => pm.response.to.have.status(200));",
