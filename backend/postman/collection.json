          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-T04: Status 200', () => pm.response.to.have.status(200));",
                  "const txns = pm.response.json().data.transactions;",
                  "pm.test('TC-T04: all results are expense', () => {",
                  "  txns.forEach(t => pm.expect(t.type).to.equal('expense'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T05 | GET transactions – filter by category=food",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?month={{testMonth}}&year={{testYear}}&category=food",
