                  "pm.test('TC-S01: success=true', () => pm.expect(body.success).to.be.true);",
                  "pm.test('TC-S01: data.totalIncome is number', () => pm.expect(body.data.totalIncome).to.be.a('number'));",
                  "pm.test('TC-S01: data.totalExpense is number', () => pm.expect(body.data.totalExpense).to.be.a('number'));",
                  "pm.test('TC-S01: data.balance is number', () => pm.expect(body.data.balance).to.be.a('number'));",
