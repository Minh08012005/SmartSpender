{
  "info": {
    "_postman_id": "smartspender-filter-statistic-v1",
    "name": "SmartSpender – Filter & Statistic",
    "description": "Postman collection for Duy: testing GET /api/transactions (filter, pagination, sorting) and GET /api/statistics/summary endpoints.\n\nPre-requisite: run POST /auth/login first to auto-set {{authToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Duy Test\",\n  \"email\": \"duy.test@example.com\",\n  \"password\": \"Test@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Register 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"duy.test@example.com\",\n  \"password\": \"Test@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const accessToken = body?.data?.accessToken || body?.data?.token;",
                  "if (accessToken) {",
                  "  pm.environment.set('authToken', accessToken);",
                  "  pm.collectionVariables.set('authToken', accessToken);",
                  "  console.log('Token set:', accessToken.substring(0,30) + '...');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Transactions – Happy Path",
      "item": [
        {
          "name": "TC-T01 | GET transactions – empty list (new user)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?month=1&year=2000",
              "host": ["{{baseUrl}}"],
              "path": ["api","transactions"],
              "query": [
                { "key": "month", "value": "1" },
                { "key": "year", "value": "2000" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-T01: Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('TC-T01: success=true', () => pm.expect(body.success).to.be.true);",
                  "pm.test('TC-T01: transactions is array', () => pm.expect(body.data.transactions).to.be.an('array'));",
                  "pm.test('TC-T01: totalCount=0 for empty month', () => pm.expect(body.data.totalCount).to.equal(0));",
                  "pm.test('TC-T01: has pagination fields', () => {",
                  "  pm.expect(body.data).to.have.property('page');",
                  "  pm.expect(body.data).to.have.property('limit');",
                  "  pm.expect(body.data).to.have.property('totalCount');",
                  "});",
                  "pm.test('TC-T01: no meta field', () => pm.expect(body.data.meta).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T02 | GET transactions – month/year with data",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?month={{testMonth}}&year={{testYear}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","transactions"],
              "query": [
                { "key": "month", "value": "{{testMonth}}" },
                { "key": "year", "value": "{{testYear}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-T02: Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('TC-T02: success=true', () => pm.expect(body.success).to.be.true);",
                  "pm.test('TC-T02: data.transactions exists', () => pm.expect(body.data.transactions).to.be.an('array'));",
                  "pm.test('TC-T02: stats block present', () => {",
                  "  pm.expect(body.data.stats).to.be.an('object');",
                  "  pm.expect(body.data.stats).to.have.property('totalIncome');",
                  "  pm.expect(body.data.stats).to.have.property('totalExpense');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T03 | GET transactions – date-range mode (from/to)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?from=2026-03-01&to=2026-03-31",
              "host": ["{{baseUrl}}"],
              "path": ["api","transactions"],
              "query": [
                { "key": "from", "value": "2026-03-01" },
                { "key": "to", "value": "2026-03-31" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-T03: Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('TC-T03: transactions array', () => pm.expect(pm.response.json().data.transactions).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T04 | GET transactions – filter by type=expense",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?month={{testMonth}}&year={{testYear}}&type=expense",
              "host": ["{{baseUrl}}"],
              "path": ["api","transactions"],
              "query": [
                { "key": "month", "value": "{{testMonth}}" },
                { "key": "year", "value": "{{testYear}}" },
                { "key": "type", "value": "expense" }
              ]
