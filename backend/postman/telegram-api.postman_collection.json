  "item": [
    {
      "name": "📱 Telegram Service Health",
      "item": [
        {
          "name": "1. GET - Health Check (Kiểm tra trạng thái Telegram)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has 'configured' field\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('configured');",
                  "});",
                  "",
                  "pm.test(\"Telegram is configured\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.configured).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/telegram/health",
              "host": ["{{BASE_URL}}"],
              "path": ["telegram", "health"]
            },
            "description": "Kiểm tra xem Telegram service có được cấu hình đúng không\n\n✅ Response:\n- configured: true (bot token + chat ID được config)\n- hasToken: true\n- hasChatId: true"
          }
        }
      ]
    },
