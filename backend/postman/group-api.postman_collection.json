              "host": ["{{BASE_URL}}"],
              "path": ["groups", "{{GROUP_ID}}"]
            }
          }
        },
        {
          "name": "4. PATCH - Cập nhật nhóm",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
