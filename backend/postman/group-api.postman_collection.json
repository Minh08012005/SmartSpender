      "type": "string"
    },
    {
      "key": "TOKEN",
      "value": "your_jwt_token_here",
      "type": "string"
    },
    {
      "key": "GROUP_ID",
      "value": "507f1f77bcf86cd799439011",
      "type": "string"
    },
    {
      "key": "USER_ID",
      "value": "507f1f77bcf86cd799439010",
      "type": "string"
    },
    {
      "key": "WALLET_ID",
      "value": "507f1f77bcf86cd799439012",
      "type": "string"
